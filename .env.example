# Required. Remnawave / Xray subscription URL.
SUBSCRIPTION_URL=

# Sent as the User-Agent when fetching the subscription.
# Default for the binary is xray-geocheck.
# Happ/4.1.0/Windows is used here so the test subscription returns Xray JSON.
USER_AGENT=Happ/4.1.0/Windows

# Optional. Override the xray-core download URL from deps.json.
# XRAY_CORE_URL=

# Optional. Override the geocheck download URL from deps.json.
# GEOCHECK_URL=

# HTTP GET target used to measure proxy latency (wall-clock RTT, not ICMP).
PING_CHECK_URL=https://www.gstatic.com/generate_204

# How often to update the subscription URL, in minutes.
SUBSCRIPTION_URL_UPDATE_INTERVAL_MINUTES=1440

# How often to run geocheck against each proxy, in minutes.
GEO_CHECK_INTERVAL_MINUTES=720

# How often to GET PING_CHECK_URL through each proxy, in minutes.
PING_CHECK_INTERVAL_MINUTES=5

# HTTP listen address for the status page.
LISTEN_ADDR=:8080

# Public URL prefix for the status page (nginx location). Default /.
# Behind location /geocheck/ set this to /geocheck
UI_BASE_PATH=/geocheck

# Prometheus metrics listen on a separate socket.
METRICS_HOST=0.0.0.0
METRICS_PORT=3113

# Prometheus scrape path. Default /metrics. Cannot be /.
METRICS_BASE_PATH=/metrics

# Optional HTTP basic auth for the metrics endpoint only.
# Both must be set, or both left empty.
# METRICS_USERNAME=
# METRICS_PASSWORD=
